# Environment reference for the Wallex trading engine. Copy to .env for local work; NEVER commit .env.
# Production secrets are files under /etc/wallex/ (see deploy/env/*.example), passed in via systemd credentials.

# ---- LLM via BoxAPI (OpenAI-compatible; used by "openai/..." AI accounts and the Liara app) ------------
BOXAPI_KEYS=REPLACE_ME_1,REPLACE_ME_2
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1

# ---- LLM provider switch (arena AI accounts on Liara) ---------------------------------------------------
# anthropic = through the team's LLM gate (plain HTTP, no SDK); boxapi = BoxAPI. The other provider takes over
# on 429/5xx/credit/auth/network errors.
LLM_PROVIDER=anthropic
# Required while LLM_PROVIDER=anthropic: the LLM gate URL and the gate token (NOT an Anthropic API key)
ANTHROPIC_BASE_URL=https://<gate-host>/meow-llm
ANTHROPIC_AUTH_TOKEN=<gate-token>
# WALLEX_ANTHROPIC_MODEL=claude-sonnet-5-5
# WALLEX_BOXAPI_MODEL=openai/gpt-6.1-sol

# ---- Liara app (deploy/liara-wallex/start.py, web.py) ----------------------------------------------
WALLEX_ADMIN_PASSWORD=REPLACE_ME
# Observability: JSON-lines logs on stdout (request/trace ids); OBS_ENV labels the environment
# OBS_ENV=liara
# LOG_LEVEL=info
# State dir (engine state, kill file, job queue) and runtime dir; the image sets these to the /data disk
# WALLEX_STATE_DIR=/data/wallex-arena
# WALLEX_RUN_DIR=/tmp/wallex
# off = dashboard only; on = engine + watchdog run in the container (still disarmed until armed on /live)
WALLEX_ENGINE=off
# Live credit sub-account (only when going live; set as Liara env vars, never in files in the repo)
WALLEX_API_KEY=
WALLEX_SUBACCOUNT_ID=
# Binance-compatible global price REST base (auto-selected on Liara: Binance, else MEXC)
# WALLEX_GLOBAL_REST=https://api.binance.com
# Optional extra connectivity probes for the self-test (comma-separated URLs)
# WALLEX_EXTRA_PROBES=

# ---- Live-trading switches (arena live accounts + watchdog) -----------------------------------------
# Orders are sent only when this is exactly 1 AND /var/lib/wallex-arena/LIVE_DISABLED does not exist.
WALLEX_LIVE_ENABLED=0
# KEY=VALUE file with WALLEX_API_KEY and WALLEX_SUBACCOUNT_ID (watchdog; the arena reads "wallex_env_file" from its config).
WALLEX_ENV_FILE=/etc/wallex/wallex.env

# ---- Self-hosted paper agent (experiments.wallex_agent; Anthropic, not used on Liara) ----------------------------------------------------------
# File containing ANTHROPIC_API_KEY=sk-ant-... (mode 0600 or a systemd credential).
WALLEX_ANTHROPIC_SECRET_FILE=/etc/wallex/anthropic.env
# SQLite ledger enforcing the LLM spend/attempt budget across restarts.
WALLEX_ANTHROPIC_BUDGET_DB=./.wallex-agent/llm-budget.sqlite

# ---- Services ----------------------------------------------------------------------------------------
# Optional override of the excluded-market list used by services/book_recorder.py.
# WALLEX_EXCLUDED_MARKETS=experiments/wallex_arena/excluded_markets.json

# ---- Legacy CryptoAlpha framework only (main.py, bot/, data/, settings.py) ---------------------------
GEMINI_API_KEYS=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
ETH_RPC_URL=https://eth.llamarpc.com
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
COINMARKETCAP_API_KEY=
COINGLASS_API_KEY=
DUNE_API_KEY=
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Secret file for LIVE trading only (arena live accounts + dead-man watchdog). Install as root:
#   sudo install -m 0600 -o root -g root wallex.env /etc/wallex/wallex.env
# Use the API key of the credit (sub-)account itself, never the main account key.
WALLEX_API_KEY=REPLACE_ME
# clientId of the credit sub-account (GET /sub-accounts); sent as the sub-account-client-id header.
WALLEX_SUBACCOUNT_ID=REPLACE_ME
